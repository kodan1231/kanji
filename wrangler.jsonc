{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kanji",
	"compatibility_date": "2026-08-22",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "kanji_db",
			"database_name": "kanji-db",
			"database_id": "3d744547-902e-463d-a7b1-e89ca605281d",
			"remote": true
		}
	]
}